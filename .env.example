# Discord Bot
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key

# Scraper (Discord Webhook で通知)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
RACER_NO=3941

# ベットエンジン設定（省略時は下記デフォルト）
# EV_THRESHOLD: 購入する最低期待値（p_final×odds）。市場ブレンドにより 1.10 ≒ モデル単体エッジ1.45相当
# PROB_FLOOR:   買い目の最低確率（的中率ガード。0.03 ≒ オッズ30倍前後までの本命〜中穴に限定）
# BLEND_LAMBDA: モデル確率と市場確率のブレンド比（1.0でモデルのみ、0.0で市場のみ）
# MAX_BETS:     1レースの最大点数
# RACE_BUDGET:  1レースの上限予算（円）。エッジが薄いレースは自動で減額される
EV_THRESHOLD=1.10
PROB_FLOOR=0.03
BLEND_LAMBDA=0.5
MAX_BETS=5
RACE_BUDGET=5000
